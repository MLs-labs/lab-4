            ],
        },

        {
            "notebook_filename": "knn_sklearn.ipynb",
            "hidden_tests_module": "labs/lab4/hidden_tests_sklearn.py",
            "checks": [
                (
                    "split",
                    "split_test(X_train, X_test, y_train, y_test)"
                ),
                (
